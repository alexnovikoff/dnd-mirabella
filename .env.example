# Секрет для подписи JWT-сессий Auth.js. Сгенерировать: openssl rand -base64 32
# Обязателен и локально, и в продакшене. Меняешь секрет — все выходят из сессий.
AUTH_SECRET=

# Строка подключения к Neon (продакшен). Пусто — приложение поднимает
# встроенный PGlite в ./.pglite, так работает локальная разработка и CI.
# Брать pooled-строку из консоли Neon: ...-pooler.<регион>.aws.neon.tech
DATABASE_URL=

# Токен хранилища Vercel Blob (продакшен). Пусто — файлы кладутся
# в public/uploads локальным драйвером.
BLOB_READ_WRITE_TOKEN=

# Пароль, которым засевается пятёрка учёток. По умолчанию «мирабелла».
# Он временный: свой пароль каждому — pnpm auth:password «Имя».
SEED_PASSWORD=
