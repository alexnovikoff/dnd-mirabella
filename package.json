{
  "name": "dnd-mirabella",
  "version": "0.1.0",
  "private": true,
  "description": "«Слёзы Мирабеллы» — сайт кампании D&D: хроника, цитаты, галерея, база знаний, доска связей.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf .pglite && DATABASE_URL= pnpm db:setup",
    "db:setup": "tsx --env-file-if-exists=.env src/lib/db/setup.ts",
    "db:resync-sessions": "tsx --env-file-if-exists=.env scripts/resync-sessions.ts",
    "auth:password": "tsx --env-file-if-exists=.env scripts/set-password.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.2.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
